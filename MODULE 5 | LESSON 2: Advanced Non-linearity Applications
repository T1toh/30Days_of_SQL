        "import pandas as pd\n",
        "import numpy as np\n",
        "import statsmodels.api as sm\n",
        "from scipy import stats\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load S&P 500 data\n",
        "spx = pd.read_csv('/content/spx.csv', index_col='Date', parse_dates=True)\n",
        "returns = spx.pct_change().dropna()\n",
        "\n",
        "# Prepare data for AR(1) model\n",
        "y = returns.values[1:]\n",
        "x = returns.values[:-1]\n",
        "\n",
        "# Center the transition variable for numerical stability\n",
        "s = x - np.mean(x)\n",
        "X = sm.add_constant(x)\n",
        "\n",
        "# Estimate linear AR(1) under null hypothesis\n",
        "linear_model = sm.OLS(y, X).fit()\n",
        "\n",
        "print(\"Linear AR(1) Model:\")\n",
        "print(f\"α = {linear_model.params[0]:.6f}\")\n",
        "print(f\"β = {linear_model.params[1]:.4f}\")\n",
        "print(f\"R² = {linear_model.rsquared:.4f}\")"
      ]
