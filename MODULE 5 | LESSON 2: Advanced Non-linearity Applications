      "source": [
        "# Create auxiliary regressors: original plus SLOPE interactions only\n",
        "# Z = [1, x, x*s, x*s², x*s³]\n",
        "w1 = x * s              # x_t * s_t\n",
        "w2 = x * s**2          # x_t * s_t²\n",
        "w3 = x * s**3          # x_t * s_t³\n",
        "\n",
        "Z = np.column_stack([X, w1, w2, w3])\n",
        "\n",
        "# Auxiliary regression on LEVELS\n",
        "auxiliary_regression = sm.OLS(y, Z).fit()\n",
        "\n",
        "# LM test statistic\n",
        "n = len(y)\n",
        "R_squared = auxiliary_regression.rsquared\n",
        "LM_statistic = n * R_squared\n",
        "\n",
        "# Degrees of freedom = number of slope interaction terms\n",
        "df = 3  # Testing significance of x*s, x*s², x*s³\n",
        "p_value = 1 - stats.chi2.cdf(LM_statistic, df)\n",
        "\n",
        "print(f\"\\nLST Test for STAR Non-linearity:\")\n",
        "print(f\"LM Statistic = {LM_statistic:.4f}\")\n",
        "print(f\"Critical value (5%) = {stats.chi2.ppf(0.95, df):.4f}\")\n",
        "print(f\"P-value = {p_value:.4f}\")\n",
        "\n",
        "if p_value < 0.05:\n",
        "    print(\"Reject H0: Evidence of smooth transition dynamics\")\n",
        "else:\n",
        "    print(\"Fail to reject H0: No strong evidence of STAR-type non-linearity\")"
